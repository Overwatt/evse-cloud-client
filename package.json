  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "PROTOCOL.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
